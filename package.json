{
  "name": "onni-laboratorio-anel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Laboratório para ler anéis QRing (Colmi/Yawell) pelo Bluetooth do navegador, antes de levar para o app Onni.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
