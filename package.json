  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "jsdom": "25.0.1",
    "playwright": "1.48.2",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
